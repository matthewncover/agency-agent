# .env.prod.example — production config template for the VPS (B8).
#
# Copy this to the server as the systemd EnvironmentFile, e.g.:
#     sudo install -m 0640 -o goalbot -g goalbot .env.prod.example /etc/agency-agent/agency.env
#     sudo -u goalbot $EDITOR /etc/agency-agent/agency.env   # fill in real values
#
# NEVER commit the filled-in file. This .example (empty secrets) is the only
# env file that belongs in the repo. `git status` must stay clean of real env.

# --- Database -------------------------------------------------------------
# Prod Postgres 16 on the VPS. Point at the local socket/host, NOT dev Docker.
# Same Alembic tree applies (profile -> goalbot -> tasktracker).
DATABASE_URL=postgresql://goalbot:CHANGEME@localhost:5432/agency

# --- Anthropic (A6) -------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium

# --- Telegram (A7): goal-bot, v1 (stopped and disabled on the VPS) ---------
# goal-bot polls (no inbound port). The routines bot below also polls, but it
# serves a Mini App behind Caddy on a public HTTPS URL (ADR-0021).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PERSON_ID=
# Shared-chat multi-person wiring (B7/B8, ADR-0020). When set, CHAT_MAP
# replaces the single pair above; the same chat id may appear for several
# persons (a shared surface), which requires USER_MAP so identity comes from
# the speaker's telegram user id, never the chat.
# TELEGRAM_CHAT_MAP=<chatid>:<personid>,<chatid>:<personid>
# TELEGRAM_USER_MAP is shared with routines and REQUIRED there (uncomment it):
# it maps Mini App users to persons.
# TELEGRAM_USER_MAP=<telegramuserid>:<personid>,<telegramuserid>:<personid>

# --- Scheduler ------------------------------------------------------------
# Leave DEBUG_MORNING_INTERVAL unset in prod: fire at the person's local time.
# MORNING_TIME=06:00     # HH:MM override of person.morning_prompt_local_time

# --- Liveness heartbeat (ADR-0017) -----------------------------------------
# Ping URL of the external dead-man's-switch check (healthchecks.io: period
# 1 day, grace 2 h — alerts if no successful morning send in > 26 h). The bot
# GETs it after each successful scheduled morning send. The URL is a secret.
# Setup steps: deploy/README.md § Liveness heartbeat.
HEARTBEAT_URL=

# --- Morning checklist (routines, ADR-0021) --------------------------------
# A separate bot and process (`python -m routines`, deploy/routines.service).
# Shares DATABASE_URL, HEARTBEAT_URL and TELEGRAM_USER_MAP with the above.
# Setup steps: deploy/README.md § Morning checklist (routines).
ROUTINES_BOT_TOKEN=
# Bot username without the leading @ (builds the Mini App direct link).
ROUTINES_BOT_USERNAME=
# Mini App short name registered with BotFather /newapp.
ROUTINES_MINIAPP_SHORT_NAME=morning
# The shared group chat id (negative number).
ROUTINES_CHAT_ID=
# Daily message time (HH:MM) in ROUTINES_TZ (IANA name).
ROUTINES_MORNING_TIME=06:00
ROUTINES_TZ=America/Los_Angeles
# The Mini App server binds localhost only; Caddy proxies /morning/ to it.
ROUTINES_HTTP_HOST=127.0.0.1
ROUTINES_HTTP_PORT=8081
# <personid>:<possessive>,... for "Matthew completed his morning routine!".
# A person missing from the map gets "their".
ROUTINES_POSSESSIVE=1:his,2:her
# !!! DEV ONLY. NEVER SET IN PROD. !!! Skips Telegram auth and acts as this
# person for every request. The server refuses to start with it unless
# ROUTINES_HTTP_HOST is 127.0.0.1. Use `just routines-dev` locally instead.
# ROUTINES_DEV_PERSON_ID=
