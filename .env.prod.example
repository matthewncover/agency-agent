# .env.prod.example — production config template for the VPS (B8).
#
# Copy this to the server as the systemd EnvironmentFile, e.g.:
#     sudo install -m 0640 -o goalbot -g goalbot .env.prod.example /etc/agency-agent/agency.env
#     sudo -u goalbot $EDITOR /etc/agency-agent/agency.env   # fill in real values
#
# NEVER commit the filled-in file. This .example (empty secrets) is the only
# env file that belongs in the repo. `git status` must stay clean of real env.

# --- Database -------------------------------------------------------------
# Prod Postgres 16 on the VPS. Point at the local socket/host, NOT dev Docker.
# Same Alembic tree applies (profile -> goalbot -> tasktracker).
DATABASE_URL=postgresql://goalbot:CHANGEME@localhost:5432/agency

# --- Anthropic (A6) -------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Telegram (A7) — polling for MVP (no public URL/TLS needed) -----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PERSON_ID=

# --- Scheduler ------------------------------------------------------------
# Leave DEBUG_MORNING_INTERVAL unset in prod: fire at the person's local time.
# MORNING_TIME=06:00     # HH:MM override of person.morning_prompt_local_time
