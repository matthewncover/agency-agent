# Local dev (Docker Compose Postgres)
DATABASE_URL=postgresql://agency:agency@localhost:5432/agency

# Anthropic (A6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Telegram (A7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PERSON_ID=

# Debug knobs (A7)
# DEBUG_MORNING_INTERVAL=120   # seconds; fires that often instead of at local time
# MORNING_TIME=06:00           # HH:MM override of person.morning_prompt_local_time

# Liveness heartbeat (ADR-0017) — leave unset in dev: no-op adapter, no watchdog needed
# HEARTBEAT_URL=               # external dead-man's-switch ping URL (healthchecks.io check)
# HEARTBEAT_TIMEOUT=10         # seconds; HTTP timeout for the ping
